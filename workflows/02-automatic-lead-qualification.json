            "first_name": "={{ $json.firstName }}",
            "reason": "={{ \"Follow-up about \" + ($json.company || \"your enquiry\") }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "externalId": "={{ 'lead-' + $json.rowNumber }}",
          "idempotencyKey": "={{ 'lead-' + $json.rowNumber + '-' + String($json.phone).replace(/[^\\d+]/g, '') }}"
        }
      },
