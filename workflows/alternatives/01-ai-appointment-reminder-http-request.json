            "version": 2
          },
          "conditions": [
            {
              "id": "573dbe31-ea9d-5120-b4df-6600aa71ed5d",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a40bd0e2-266c-5938-950f-25f6044f3c3b",
      "name": "Has a phone number?",
