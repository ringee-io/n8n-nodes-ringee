    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ringee.io/api/v1/ai-voice-agents/YOUR_AGENT_ID/calls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'reminder-' + $json.eventId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ to: $json.phone, variables: { first_name: $json.firstName, notification: $json.title, appointment_date: $json.date, appointment_time: $json.time }, metadata: { external_id: 'reminder-' + $json.eventId } }) }}",
        "options": {}
      },
      "id": "58194cb8-b953-59ff-a0ae-c44fb93cd52c",
      "name": "Start the call (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1240,
        -200
      ]
    },
    {
