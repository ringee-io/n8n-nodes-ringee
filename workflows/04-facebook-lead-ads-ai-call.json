          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "phoneNumber": "={{ $json.phone }}",
        "variables": {
          "mappingMode": "defineBelow",
          "value": {
            "first_name": "={{ String($json.fullName || 'there').split(' ')[0] }}",
            "email": "={{ $json.email }}",
            "reason": "You asked us to contact you through our Facebook ad"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "externalId": "={{ 'fb-' + $json.leadId }}",
          "idempotencyKey": "={{ 'fb-' + $json.leadId }}"
        }
      },
      "id": "dfb412a2-2423-558c-89a2-4581fc700394",
      "name": "Start the first call",
