            "index": 0
          }
        ]
      ]
    },
    "Find the contact in HubSpot": {
      "main": [
        [
          {
            "node": "Log the new meeting in HubSpot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
