        [
          {
            "node": "Get AI summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get AI summary": {
      "main": [
        [
          {
            "node": "Write the Slack message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the Slack message": {
      "main": [
        [
          {
            "node": "Post to Slack",
