              "name": "phone",
              "value": "={{ (() => { const p = $json.properties || {}; const v = x => (x && typeof x === 'object' && 'value' in x) ? x.value : x; return String(v(p.phone) || v(p.mobilephone) || '').trim(); })() }}",
              "type": "string"
            },
