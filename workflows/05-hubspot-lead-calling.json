        "operation": "get",
        "contactId": {
          "__rl": true,
          "value": "={{ $json.objectId }}",
          "mode": "id"
        },
        "additionalFields": {
          "propertiesCollection": {
            "propertiesValues": {
              "properties": [
                "firstname",
                "lastname",
                "phone",
                "mobilephone",
                "email"
              ],
              "propertyMode": "valueOnly"
            }
          }
        }
      },
