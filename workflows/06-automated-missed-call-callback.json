            "node": "Call them back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call them back": {
      "main": [
        [
          {
            "node": "Log the callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
